# ── Environment ────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ── Trading ─────────────────────────────────────────────────────────────────────
# 'paper' simulates fills with Uniswap V2 constant-product math, no on-chain execution
# 'real'  executes actual swaps via Uniswap V2 Router02 on Robinhood Chain (EVM)
TRADING_MODE=paper
PAPER_BALANCE_NATIVE=10

# Trade parameters
TRADE_SIZE_NATIVE=0.05
TAKE_PROFIT_PCT=100
SELL_PCT_AT_TP=50
STOP_LOSS_PCT=50
MAX_OPEN_POSITIONS=5
DAILY_LOSS_LIMIT_NATIVE=0.5
# Minimum market cap at entry (USD). Skip tokens still at the launch floor (no buy
# pressure). Set 0 to disable the gate.
MIN_ENTRY_MC_USD=3000
# Minimum ETH liquidity in the Uniswap V2 pair to consider trading.
MIN_LIQUIDITY_NATIVE=0.1

# ── Multi-tier entry ────────────────────────────────────────────────────────────
TIER1_MC_USD=8000
TIER2_MC_USD=5000
MIN_DETECTOR_SCORE=35
MIN_DETECTOR_SCORE_TIER2=50
MIN_DETECTOR_SCORE_TIER3=65
# DEPRECATED: social links vinham do metadata URI (Pump.fun) — nao existe em ERC-20 puro.
# Substituido pelos gates on-chain TIER2/TIER3_MIN_SUPPLY_IN_POOL_PCT abaixo.
REQUIRE_SOCIAL_TIER2=false
# % minimo do supply total que precisa estar no pool Uniswap (sinal anti-dump)
TIER2_MIN_SUPPLY_IN_POOL_PCT=15
TIER3_MIN_SUPPLY_IN_POOL_PCT=25
# Honeypot probe: rejeita token se a taxa simulada de compra/venda exceder estes %
HONEYPOT_MAX_BUY_TAX_PCT=10
HONEYPOT_MAX_SELL_TAX_PCT=10
REQUIRE_FRESH_DEPLOYER_TIER3=true
MIN_TOKEN_AGE_MS=3000
MIN_DEV_BUY_NATIVE=0.05
MIN_WALLET_BALANCE_NATIVE=0.1
DEV_SELL_ABANDON_PCT=10

# ── Robinhood Chain RPC ─────────────────────────────────────────────────────────
# QuickNode or equivalent Robinhood Chain (Chain ID 4663) RPC endpoint.
# Get one at https://www.quicknode.com/ — select "Robinhood" chain.
ROBBINHOOD_RPC_URL=https://your-endpoint-name.robinhood-mainnet.quiknode.pro/your-api-key/
# WebSocket endpoint (optional — used for event subscriptions). Falls back to
# HTTP polling if not provided.
ROBBINHOOD_WS_URL=wss://your-endpoint-name.robinhood-mainnet.quiknode.pro/your-api-key/
ROBBINHOOD_CHAIN_ID=4663

# ── Uniswap V2 on Robinhood ─────────────────────────────────────────────────────
# Uniswap V2 Factory contract address on Robinhood Chain.
# Verified: 0x8bcEaA40B9AcdfAedF85AdF4FF01F5Ad6517937f (6659+ pairs)
UNISWAP_FACTORY_ADDRESS=0x8bcEaA40B9AcdfAedF85AdF4FF01F5Ad6517937f
# Uniswap V2 Router02 address (for swap execution).
UNISWAP_ROUTER_ADDRESS=0x89e5DB8B5aA49aA85AC63f691524311AEB649eba
# WETH address on Robinhood Chain.
WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73

# ── Database ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://bot:bot_password@localhost:5432/robinhood_bot

# ── Redis ───────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Telegram ────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Accepts a comma-separated list to fan alerts out to multiple chats,
# e.g. "123456789,-987654321" (DM + group).
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── Wallet (required for real trading) ───────────────────────────────────────────
# Bot wallet private key (hex, with or without 0x prefix).
WALLET_PRIVATE_KEY=0xyour_private_key_here

# ── MEV Protection (optional) ───────────────────────────────────────────────────
# Flashbots / MEV relay endpoint for private transaction submission.
# MEV_RELAY_URL=https://relay.flashbots.net

# ── Observability ───────────────────────────────────────────────────────────────
PORT=3000
